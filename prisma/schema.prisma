generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CLINIC
  RECEPTIONIST
  DOCTOR
  PATIENT
  DIAGNOSTIC_CENTER
  DIAGNOSTIC_STAFF
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum QueueMode {
  LIVE
  PRIVATE
  TIME_SLOT
}

enum QueueStatus {
  OPEN
  PAUSED
  CLOSED
}

enum AppointmentStatus {
  WAITING
  CHECKED_IN
  ABSENT
  COMPLETED
  CANCELLED
}

enum BookingSource {
  ONLINE
  RECEPTION
  WALK_IN
  PHONE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

enum RequestedBy {
  DOCTOR
  CLINIC
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}


model User {
  id             String       @id @default(uuid())
  name           String
  email          String?      @unique
  password       String?
  phone          String?      @unique
  role           Role
  provider       AuthProvider @default(LOCAL)
  googleId       String?      @unique
  avatar         String?
  isVerified     Boolean      @default(false)
  isActive       Boolean      @default(true)
  refreshToken   String?
  selfRegistered Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic       Clinic?
  doctor       Doctor?
  receptionist Receptionist?
  patient      Patient?
  diagnosticCenter      DiagnosticCenter?
  diagnosticCenterStaff DiagnosticCenterStaff?
  notifications Notification[]

  @@map("users")
}

model Clinic {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String   @unique
  clinicName String
  address    String?
  city       String?
  state      String?
  pincode    String?
  latitude   Float?
  longitude  Float?
  logo       String?
  isApproved Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  onlineConsultationEnabled Boolean @default(true)

  doctors             Doctor[]
  receptionists       Receptionist[]
  announcements       Announcement[]
  doctorAssociations  DoctorClinicAssociation[]
  queues              Queue[]
  appointments        Appointment[]
  workingHours ClinicWorkingHours[]
  holidays     ClinicHoliday[]
  receptionistDoctors ReceptionistDoctor[]
  reviews             Review[]
  doctorLeaves        DoctorLeave[]
  referredTestRecommendations TestRecommendation[] @relation("ReferringClinic")
  targetedTestRecommendations TestRecommendation[] @relation("TargetClinic")
  testReferrals TestReferral[]

  @@map("clinics")
}

model Doctor {
  id             String    @id @default(uuid())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String    @unique
  clinic         Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  clinicId       String
  specialization String?
  qualification  String?
  experience     Int?
  fee            Float?
  isVerified     Boolean   @default(false)
  queueMode      QueueMode @default(LIVE)
  startTime      String?
  profilePhoto   String?
  avgConsultationMinutes Int? // used to estimate patient wait time

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedReceptionists ReceptionistDoctor[]
  queues                Queue[]
  appointments          Appointment[]
  announcements         Announcement[]
  clinicAssociations    DoctorClinicAssociation[]
  reviews               Review[]
  leaves                DoctorLeave[]

  @@map("doctors")
}

model Receptionist {
  id       String @id @default(uuid())
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String @unique
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  clinicId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedDoctors ReceptionistDoctor[]

  @@map("receptionists")
}

model ReceptionistDoctor {
  id             String       @id @default(uuid())
  receptionist   Receptionist @relation(fields: [receptionistId], references: [id], onDelete: Cascade)
  receptionistId String
  doctor         Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  doctorId       String
  clinic         Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  clinicId       String

  createdAt DateTime @default(now())

  @@unique([receptionistId, doctorId, clinicId])
  @@map("receptionist_doctors")
}

model Patient {
  id     String  @id @default(uuid())
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String? @unique

  // For guest/walk-in patients who have no login account —
  // these hold the identity directly on the Patient record.
  // For self-registered patients, name/phone live on the linked User instead.
  name  String?
  phone String?

  dob        DateTime?
  age        Int?
  gender     String?
  bloodGroup String?
  address    String?
  latitude   Float?
  longitude  Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]
  reviews      Review[]
  testRecommendations TestRecommendation[]
  testReferrals TestReferral[]

  @@map("patients")
}

model Queue {
  id              String      @id @default(uuid())
  doctor          Doctor      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  doctorId        String
  clinic          Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  clinicId        String
  date            DateTime    @db.Date
  currentToken    Int         @default(0)
  lastTokenIssued Int         @default(0)
  status          QueueStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]
  logs         QueueLog[]

  @@unique([doctorId, clinicId, date])
  @@map("queues")
}

model QueueLog {
  id          String   @id @default(uuid())
  queue       Queue    @relation(fields: [queueId], references: [id], onDelete: Cascade)
  queueId     String
  action      String
  performedBy String
  meta        Json?

  createdAt DateTime @default(now())

  @@map("queue_logs")
}

model Appointment {
  id            String            @id @default(uuid())
  doctor        Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  doctorId      String
  clinic        Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  clinicId      String
  patient       Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId     String
  queue         Queue             @relation(fields: [queueId], references: [id], onDelete: Cascade)
  queueId       String
  token         Int
  date          DateTime          @db.Date
  status        AppointmentStatus @default(WAITING)
  bookingSource BookingSource
  isEmergency   Boolean           @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review Review?
  cancelReason      String?
  cancelledBy       String? // userId of whoever cancelled it
  testRecommendations TestRecommendation[]
  testReferrals TestReferral[]

  @@unique([doctorId, clinicId, date, token])
  @@map("appointments")
}

// Singleton table — always exactly one row — holds platform-wide configurable settings
model PlatformSetting {
  id                   String @id @default(uuid())
  bookingWindowMinutes Int    @default(180)

  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

enum AnnouncementType {
  DOCTOR_ABSENT
  CLINIC_CLOSED
  HOLIDAY
  EMERGENCY
  MAINTENANCE
  GENERAL
}

model Announcement {
  id        String           @id @default(uuid())
  type      AnnouncementType
  title     String
  message   String

  // null clinicId = platform-wide (posted by Admin/Super Admin)
  clinic   Clinic? @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  clinicId String?

  // optional — ties the notice to one specific doctor (e.g. "Dr. X absent today")
  doctor   Doctor? @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  doctorId String?

  createdByUserId String
  isActive        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("announcements")
}

model DoctorClinicAssociation {
  id       String @id @default(uuid())
  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  doctorId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  clinicId String

  fee       Float?
  queueMode QueueMode @default(LIVE)

  dayOfWeek DayOfWeek
  startTime String // "HH:mm"
  endTime   String // "HH:mm"

  status      RequestStatus @default(PENDING)
  requestedBy RequestedBy

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("doctor_clinic_associations")
}

model ClinicWorkingHours {
  id       String    @id @default(uuid())
  clinic   Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  clinicId String
  dayOfWeek DayOfWeek
  openTime  String? // "HH:mm" — null if closed that day
  closeTime String? // "HH:mm"
  isClosed  Boolean @default(false)
  avgConsultationMinutes Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clinicId, dayOfWeek])
  @@map("clinic_working_hours")
}

model ClinicHoliday {
  id       String   @id @default(uuid())
  clinic   Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  clinicId String
  date     DateTime @db.Date
  reason   String?

  createdAt DateTime @default(now())

  @@unique([clinicId, date])
  @@map("clinic_holidays")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id            String       @id @default(uuid())
  appointment   Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  appointmentId String       @unique
  patient       Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId     String
  doctor        Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  doctorId      String
  clinic        Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  clinicId      String

  rating  Int
  comment String?
  status  ReviewStatus @default(PENDING)

  isReported   Boolean @default(false)
  reportReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reviews")
}
enum NotificationType {
  APPOINTMENT_BOOKED
  APPOINTMENT_CANCELLED
  CLINIC_APPROVED
  CLINIC_REVOKED
  DOCTOR_VERIFIED
  CONNECTION_REQUEST_RECEIVED
  CONNECTION_REQUEST_RESPONDED
  GENERAL
}

model Notification {
  id        String           @id @default(uuid())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      NotificationType @default(GENERAL)
  title     String
  message   String
  isRead    Boolean          @default(false)
  meta      Json?

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

model DoctorLeave {
  id       String @id @default(uuid())
  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  doctorId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  clinicId String
  date     DateTime @db.Date
  reason   String?

  createdAt DateTime @default(now())

  @@unique([doctorId, clinicId, date])
  @@map("doctor_leaves")
}

model TestRecommendation {
  id            String       @id @default(uuid())
  patient       Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId     String
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  appointmentId String?

  testName String
  notes    String?

  referringClinic   Clinic? @relation("ReferringClinic", fields: [referringClinicId], references: [id], onDelete: SetNull)
  referringClinicId String?

  targetClinic     Clinic? @relation("TargetClinic", fields: [targetClinicId], references: [id], onDelete: SetNull)
  targetClinicId   String?
  targetCenterName String?

  createdByUserId String
  createdByRole   Role

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("test_recommendations")
}

model DiagnosticCenter {
  id         String  @id @default(uuid())
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String  @unique
  centerName String
  address    String?
  city       String?
  state      String?
  pincode    String?
  latitude   Float?
  longitude  Float?
  logo       String?
  isApproved Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff             DiagnosticCenterStaff[]
  incomingReferrals TestReferral[]

  @@map("diagnostic_centers")
}

model DiagnosticCenterStaff {
  id                 String           @id @default(uuid())
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String           @unique
  diagnosticCenter   DiagnosticCenter @relation(fields: [diagnosticCenterId], references: [id], onDelete: Cascade)
  diagnosticCenterId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("diagnostic_center_staff")
}

model TestReferral {
  id            String       @id @default(uuid())
  patient       Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId     String
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  appointmentId String?

  testNames String[]
  notes     String?

  referringClinic   Clinic? @relation(fields: [referringClinicId], references: [id], onDelete: SetNull)
  referringClinicId String?

  diagnosticCenter   DiagnosticCenter @relation(fields: [diagnosticCenterId], references: [id], onDelete: Cascade)
  diagnosticCenterId String

  createdByUserId String
  createdByRole   Role

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("test_referrals")
}